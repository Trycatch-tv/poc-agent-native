  "requirements": [
    {
      "id": "USAGE-001",
      "component": "usage-tracker",
      "title": "Validación de eventos positivos",
      "statement": "Si events_count < 0, aborta retornando código de error -1.",
      "status": "active",
      "version": 1,
      "source": {
        "type": "narrative",
        "ref_target": "narrative-subscription-service.md#usage-001"
      },
      "acceptance_criteria": [
        "events_count < 0 retorna -1"
      ]
    },
    {
      "id": "USAGE-002",
      "component": "usage-tracker",
      "title": "Cálculo de unidades de cómputo",
      "statement": "unidades = events_count + (bytes_transferred_mb / 10).",
      "status": "active",
      "version": 1,
      "source": {
        "type": "narrative",
        "ref_target": "narrative-subscription-service.md#usage-002"
      },
      "acceptance_criteria": [
        "Unidades corresponden a eventos + MB / 10"
      ]
    },
    {
      "id": "BILL-001",
      "component": "subscription-billing",
      "title": "Cargo por plan mensual recurrente",
      "statement": "Plan base fijado en 2,900 centavos ($29.00 USD) mensuales.",
      "status": "active",
      "version": 1,
      "source": {
        "type": "narrative",
        "ref_target": "narrative-subscription-service.md#bill-001"
      },
      "acceptance_criteria": [
        "Base plan es 2900 centavos"
      ]
    },
    {
      "id": "BILL-002",
      "component": "subscription-billing",
      "title": "Delegación de cómputo de uso",
      "statement": "Invoca usage-tracker.calculate_units y liquida 5 centavos por unidad consumida.",
      "status": "active",
      "version": 1,
      "source": {
        "type": "narrative",
        "ref_target": "narrative-subscription-service.md#bill-002"
      },
      "acceptance_criteria": [
        "Multiplica unidades calculadas por 5 centavos"
      ]
    }
